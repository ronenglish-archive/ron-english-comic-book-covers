:root {
  --bg: #111318;
  --panel: rgba(255,255,255,.055);
  --panel-strong: rgba(255,255,255,.095);
  --text: #f4f4f5;
  --muted: #c6c8d0;
  --line: rgba(255,255,255,.16);
  --link: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.55;
  background: radial-gradient(circle at top left, #2d3140 0, #111318 44%, #090a0d 100%);
  color: var(--text);
}

a {
  color: var(--link);
}

.site-header {
  max-width: 1180px;
  margin: 0 auto;
  padding: 2rem 1rem 1rem;
}

.site-header h1 {
  margin: 0 0 1rem;
  font-size: clamp(2rem, 5vw, 4rem);
  line-height: 1.05;
}

.site-header p {
  max-width: 860px;
  color: var(--muted);
}

.top-nav {
  display: flex;
  flex-wrap: wrap;
  gap: .55rem;
  margin: .75rem 0 0;
}

.nav-pill {
  display: inline-block;
  padding: .55rem .85rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel);
  color: var(--text);
  text-decoration: none;
  font-size: .95rem;
}

.nav-pill:hover,
.nav-pill.is-active {
  background: var(--panel-strong);
}

.work-layout,
.index-layout {
  max-width: 1180px;
  margin: 0 auto;
  padding: 1rem 1rem 3rem;
}

.hero-card {
  margin: 0 0 1.5rem;
  padding: .95rem;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0,0,0,.25);
}

.hero-card img,
.work-hero {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 10px;
}

.work-meta,
.section-block ul {
  list-style: none;
  padding-left: 0;
  margin-left: 0;
}

.work-meta {
  display: grid;
  gap: .45rem;
  margin: 0 0 1.6rem;
  padding: 1rem;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
}

.work-meta li,
.section-block li {
  list-style: none;
  margin-left: 0;
}

.section-block {
  margin: 1.5rem 0 0;
  padding: 1rem;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
}

.section-block h2 {
  margin: 0 0 .75rem;
  font-size: 1.25rem;
}

.section-block p,
.section-block li {
  line-height: 1.6;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

.gallery-card {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
  overflow: hidden;
  color: var(--text);
  text-decoration: none;
  box-shadow: 0 10px 28px rgba(0,0,0,.18);
}

.gallery-card:hover {
  background: var(--panel-strong);
  transform: translateY(-2px);
}

.gallery-card img {
  display: block;
  width: 100%;
  height: 310px;
  object-fit: contain;
  padding: .75rem;
  background: rgba(0,0,0,.20);
}

.gallery-card-text {
  padding: .85rem .95rem 1rem;
}

.gallery-card-title {
  display: block;
  font-weight: 700;
  line-height: 1.3;
}

.gallery-card-id {
  display: block;
  margin-top: .35rem;
  color: var(--muted);
  font-size: .92rem;
}

@media (max-width: 820px) {
  .gallery-card img {
    height: 260px;
  }
}
